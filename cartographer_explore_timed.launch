<launch>
	<!-- cartographer_explore_timed.launch
         Autonomous SLAM exploration with Cartographer + explore_lite
         + block detection + auto-return after timeout.

         Usage:
           roslaunch coverage_block_search cartographer_explore_timed.launch
           roslaunch coverage_block_search cartographer_explore_timed.launch duration:=120
    -->

	<!-- ======== Args ======== -->
	<arg name="start_driver"     default="true"/>
	<arg name="start_lidar"      default="true"/>
	<arg name="use_lidar_filter" default="true"/>
	<arg name="start_camera"     default="true"/>
	<arg name="show_debug_window" default="true"/>

	<arg name="scan_raw_topic" default="/scan_raw"/>
	<arg name="rgb_topic"     default="/camera/camera/color/image_raw"/>
	<arg name="depth_topic"   default="/camera/camera/depth/image_raw"/>
	<arg name="scan_topic"     default="/scan"/>
	<arg name="cmd_vel_topic"  default="/controller/cmd_vel"/>
	<arg name="odom_topic"     default="odom_raw"/>
	<arg name="map_frame"      default="map"/>
	<arg name="odom_frame"     default="odom"/>
	<arg name="base_frame"     default="base_footprint"/>
	<arg name="lidar_frame"    default="lidar_frame"/>

	<!-- Exploration duration in seconds (default 3 min) -->
	<arg name="duration"       default="180"/>

	<!-- ======== Layer 1: Hardware Drivers ======== -->

	<include if="$(arg start_driver)" file="$(find driver)/launch/ekf_fusion.launch"/>

	<include if="$(eval start_lidar and use_lidar_filter)" file="$(find lidar_driver)/launch/ld_lidar.launch">
		<arg name="topic_name" value="$(arg scan_raw_topic)"/>
	</include>

	<node if="$(eval start_lidar and use_lidar_filter)" pkg="laser_filters"
          type="scan_to_scan_filter_chain" output="screen" name="coverage_laser_filter">
		<rosparam ns="scan_filter_chain" subst_value="true">
			- name: angle
			type: laser_filters/LaserScanAngularBoundsFilterInPlace
			params:
			lower_angle: 1.54
			upper_angle: 4.71
		</rosparam>
		<remap from="scan" to="$(arg scan_raw_topic)"/>
		<remap from="scan_filtered" to="$(arg scan_topic)"/>
	</node>

	<include if="$(eval start_lidar and not use_lidar_filter)" file="$(find lidar_driver)/launch/ld_lidar.launch">
		<arg name="topic_name" value="$(arg scan_topic)"/>
	</include>

	<!-- Arm/camera reset: position the camera arm to point at the ground -->
	<node if="$(arg start_camera)" name="arm_camera_reset" pkg="coverage_block_search"
          type="arm_camera_reset.py" output="screen">
		<param name="startup_delay" value="0.8"/>
		<param name="duration" value="1.0"/>
		<param name="positions" value="1:500,2:470,3:210,4:70,5:500,10:200"/>
	</node>

	<!-- Camera (required for block detection) -->
	<include if="$(arg start_camera)" file="$(find camera_driver)/launch/depth_cam.launch"/>

	<!-- ======== Layer 2: TF Publishers ======== -->

	<node pkg="tf" type="static_transform_publisher" name="base_to_lidar"
          args="0 0 0.1 3.14 0 0 $(arg base_frame) $(arg lidar_frame) 20"/>
	<node pkg="tf" type="static_transform_publisher" name="base_to_imu"
          args="0 0 0.0 1.57 3.14 0 $(arg base_frame) imu_frame 20"/>

	<!-- ======== Layer 3: Cartographer SLAM ======== -->

	<param name="/use_sim_time" value="false"/>

	<node name="cartographer_node" pkg="cartographer_ros"
          type="cartographer_node" args="
              -configuration_directory $(find cartographer_ros)/configuration_files
              -configuration_basename my_robot_2d.lua"
          output="screen">
		<remap from="scan" to="$(arg scan_topic)"/>
		<remap from="imu" to="/imu_corrected"/>
		<remap from="odom" to="odom_raw"/>
	</node>

	<node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
          type="cartographer_occupancy_grid_node" args="-resolution 0.05">
		<remap from="map" to="/cartographer_map_raw"/>
	</node>

	<node pkg="robot_slam_navigation" type="cartographer_map_converter.py"
          name="map_converter" output="screen">
		<param name="output_topic" value="/cmap"/>
		<param name="obstacle_threshold" value="70"/>
		<param name="free_threshold" value="50"/>
	</node>

	<!-- ======== Layer 4: move_base ======== -->

	<include file="$(find robot_slam_navigation)/launch/move_base.launch">
		<arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
		<arg name="global_costmap_map_topic" value="cmap"/>
		<arg name="global_costmap_sensor_frame" value="$(arg base_frame)"/>
		<arg name="global_costmap_sensor_topic" value="$(arg scan_topic)"/>
		<arg name="global_costmap_global_frame" value="$(arg map_frame)"/>
		<arg name="global_costmap_robot_base_frame" value="$(arg base_frame)"/>
		<arg name="local_costmap_map_topic" value="odom"/>
		<arg name="local_costmap_sensor_frame" value="$(arg base_frame)"/>
		<arg name="local_costmap_sensor_topic" value="$(arg scan_topic)"/>
		<arg name="local_costmap_global_frame" value="$(arg odom_frame)"/>
		<arg name="local_costmap_robot_base_frame" value="$(arg base_frame)"/>
		<arg name="teb_odom_topic" value="$(arg odom_topic)"/>
		<arg name="teb_map_frame" value="$(arg odom_frame)"/>
	</include>

	<param name="/move_base/recovery_behavior_enabled" value="false"/>
	<param name="/move_base/clearing_rotation_allowed" value="false"/>
	<param name="/move_base/global_costmap/obstacle_layer/track_unknown_space" value="true"/>


	<!-- ======== Layer 5: Block Detector ======== -->

	<node name="block_detector" pkg="coverage_block_search" type="block_detector.py" output="screen">
		<rosparam command="load" file="$(find coverage_block_search)/config/default.yaml"/>
		<param name="show_debug_window" value="$(arg show_debug_window)"/>
	</node>

	<!-- ======== Layer 6: explore_lite ======== -->

	<node pkg="explore_lite" type="explore" respawn="false" name="explore" output="screen">
		<param name="robot_base_frame" value="$(arg base_frame)"/>
		<param name="costmap_topic" value="cmap"/>

		<param name="visualize" value="true"/>
		<param name="planner_frequency" value="0.5"/>
		<param name="progress_timeout" value="25.0"/>
		<param name="potential_scale" value="2.5"/>
		<param name="orientation_scale" value="0.0"/>
		<param name="gain_scale" value="1.0"/>
		<param name="transform_tolerance" value="0.5"/>
		<param name="min_frontier_size" value="0.5"/>
	</node>

	<!-- ======== Layer 7: Timed Explore Guard ======== -->

	<node pkg="coverage_block_search" type="timed_explore_guard.py" name="timed_explore_guard"
          output="screen" required="true">
		<param name="duration" value="$(arg duration)"/>
		<param name="detection_topic" value="/coverage_block_search/detection"/>
		<param name="goal_topic" value="/move_base_simple/goal"/>
		<param name="map_frame" value="$(arg map_frame)"/>
		<param name="base_frame" value="$(arg base_frame)"/>
		<param name="explore_node" value="/explore"/>
	</node>

</launch>